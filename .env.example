# Application URL
NEXT_PUBLIC_SITE_URL=https://painandparalysis.com

# Site Metadata
NEXT_PUBLIC_SITE_NAME="Pain and Paralysis Clinic"

# Contact Configuration (Optional/Phase-dependent)
